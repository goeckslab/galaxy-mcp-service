HOST=0.0.0.0
PORT=8080
# External HTTP(S) origin without a path. Leave blank only for loopback access.
PUBLIC_BASE_URL=

# Galaxy connection. Set both values together; keep the key out of source control.
GALAXY_URL=
GALAXY_API_KEY=

# Production Universal mode. Leave these blank when using the local shared connection above.
OAUTH_METADATA_URL=
OAUTH_INTROSPECTION_CLIENT_ID=
OAUTH_INTROSPECTION_CLIENT_SECRET=
GALAXY_INSTANCES_JSON=
